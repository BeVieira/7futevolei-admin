PORT=3333
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=futevolei_admin
DATABASE_URL="postgresql://postgres:postgres@db:5432/futevolei_admin?schema=public"
JWT_SECRET=troque-por-um-segredo-aleatorio-longo

# Origem(s) do front que podem chamar a API entre domínios diferentes,
# separadas por vírgula (ex: https://app.7futevolei.com.br). Em dev, deixe
# vazio — o front acessa a API via proxy do Vite (mesma origem). Em
# produção (front na Vercel, back no Render) é obrigatório: sem a origem
# exata da Vercel aqui, o navegador bloqueia a resposta e os cookies de
# sessão não são aceitos.
CORS_ORIGIN=

# Bucket de Storage do Supabase onde os comprovantes são salvos (precisa
# existir e estar marcado como público — ver DEPLOY.md). Usado em qualquer
# ambiente, inclusive dev local: não há mais upload em disco.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=receipts

# Chaves VAPID das notificações push (Web Push). Gere um par com
# `npx web-push generate-vapid-keys` — use um par diferente em cada ambiente
# (dev/produção). Trocar o par invalida todas as inscrições existentes: os
# aparelhos precisam ativar as notificações de novo. Sem essas variáveis o
# resto da API funciona normalmente; só as rotas /api/push respondem 503.
# VAPID_SUBJECT é um contato do responsável (mailto: ou https:), exigido
# pelos serviços de push do Google/Apple/Mozilla.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@exemplo.com

# Login com Google (Client ID do OAuth, tipo "Aplicativo da Web") — é o
# único jeito de entrar, pra aluno e admin. Precisa do mesmo valor em
# VITE_GOOGLE_CLIENT_ID no front. No console do Google, cadastre a origem do
# front em "Origens JavaScript autorizadas" e
# <origem do front>/api/auth/google/callback em "URIs de redirecionamento
# autorizados" (ex: http://localhost:5173 e
# http://localhost:5173/api/auth/google/callback em dev). Sem
# GOOGLE_CLIENT_ID o resto da API sobe normalmente, mas o login responde 503.
GOOGLE_CLIENT_ID=

# E-mails que entram como admin, separados por vírgula, escritos exatamente
# como aparecem na conta Google (a comparação ignora maiúsculas). O papel é
# recalculado a cada login e a cada renovação de sessão, então tirar um
# e-mail daqui rebaixa a conta em até 5 minutos (o access token em uso
# continua valendo até expirar). Toda mudança de papel aparece no log.
ADMIN_EMAILS=

# Quantos proxies confiáveis ficam entre o usuário e o backend (ver
# src/index.ts). Em dev, deixe vazio/0. Em produção (rewrite da Vercel →
# proxies do Render) a estimativa é 4 — não verificada; confirme depois do
# deploy como explicado no DEPLOY.md: errado pra menos, o rate limit de
# login vira global; pra mais, o cliente consegue forjar o próprio IP.
TRUST_PROXY_HOPS=
