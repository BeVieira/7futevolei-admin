PORT=3333
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=futevolei_admin
DATABASE_URL="postgresql://postgres:postgres@db:5432/futevolei_admin?schema=public"
JWT_SECRET=troque-por-um-segredo-aleatorio-longo
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Origem(s) do front que podem chamar a API entre domínios diferentes,
# separadas por vírgula (ex: https://app.7futevolei.com.br). Em dev, deixe
# vazio — o front acessa a API via proxy do Vite (mesma origem). Em
# produção (front na Vercel, back no Render) é obrigatório: sem a origem
# exata da Vercel aqui, o navegador bloqueia a resposta e os cookies de
# sessão não são aceitos.
CORS_ORIGIN=

# Bucket de Storage do Supabase onde os comprovantes são salvos (precisa
# existir e estar marcado como público — ver DEPLOY.md). Usado em qualquer
# ambiente, inclusive dev local: não há mais upload em disco.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=receipts
