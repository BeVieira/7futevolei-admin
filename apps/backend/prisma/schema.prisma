generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EnrollmentStatus {
  CONFIRMED
  WAITLISTED
}

enum Side {
  LEFT
  RIGHT
}

enum UserRole {
  STUDENT
  ADMIN
}

enum ReceiptStatus {
  PENDING
  APPROVED
  REJECTED
}

model ClassSession {
  id          Int          @id @default(autoincrement())
  date        DateTime
  startTime   String
  endTime     String
  classLevel  String
  capacity    Int          @default(8)
  lockAt      String?
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([date])
}

// Uma inscrição é de um usuário logado (`userId`) **ou** de um convidado
// inscrito pelo admin só pelo nome (`guestName`) — exatamente um dos dois,
// garantido pelo enrollment-service e por um CHECK na migration. O nome
// exibido de quem tem `userId` é sempre o `User.name` atual (join), nunca
// uma cópia. `onDelete: Restrict` no usuário: apagar a conta direto no
// banco apagaria as inscrições em cascata sem passar pela promoção da lista
// de espera (enrollment-service) e levaria os comprovantes junto — hoje não
// existe "excluir conta"; quando existir, precisa cancelar as inscrições
// pelo service antes.
model Enrollment {
  id                    Int              @id @default(autoincrement())
  classSession          ClassSession     @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  classSessionId        Int
  user                  User?            @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId                Int?
  guestName             String?
  // Convidado que se inscreveu sozinho (sem conta): sha256 do código secreto
  // que ficou no aparelho dele e permite cancelar. Nulo para usuário e para
  // convidado inscrito pelo admin.
  guestCancelTokenHash  String?          @unique
  side                  Side
  status                EnrollmentStatus @default(CONFIRMED)
  receiptReminderSentAt DateTime?
  createdAt             DateTime         @default(now())
  receipt               Receipt?

  // Um usuário só tem uma inscrição por turma. Convidados (`userId` nulo)
  // ficam de fora: no Postgres, NULL nunca colide num índice único.
  @@unique([classSessionId, userId])
  @@index([classSessionId, status])
  @@index([userId])
}

// Conta criada no primeiro login com Google (não existe cadastro nem senha).
// `role` é recalculado a cada login a partir de `ADMIN_EMAILS`; `name`
// nasce do Google mas é editável pelo próprio usuário e não é sobrescrito
// nos logins seguintes.
model User {
  id                Int                @id @default(autoincrement())
  googleId          String             @unique
  // O e-mail em texto não fica no banco (ver lib/email-crypto.ts):
  // `emailHash` (HMAC) é pra comparar/buscar, `emailEncrypted` (AES-GCM) é
  // pra mostrar no perfil. Nulos só em conta antiga ainda não migrada.
  emailHash         String?            @unique
  emailEncrypted    String?
  // Legado: e-mail em texto de contas criadas antes do hash. Ninguém grava
  // mais; o script src/scripts/hash-user-emails.ts converte e apaga, e a
  // coluna sai numa migration seguinte.
  email             String?            @unique
  name              String
  photoUrl          String?
  role              UserRole           @default(STUDENT)
  // Lado da quadra que o aluno costuma escolher: só pré-seleciona o
  // formulário de inscrição, cada inscrição continua com o próprio `side`.
  preferredSide     Side?
  sessions          Session[]
  enrollments       Enrollment[]
  pushSubscriptions PushSubscription[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

// Uma sessão por aparelho/navegador logado (multi-sessão: logar no celular
// não derruba o computador). Guarda o `jti` vigente de cada token do par —
// é isso que torna os JWTs revogáveis antes de expirar. Refresh rotaciona os
// dois `jti` só desta sessão; logout apaga só esta sessão.
// `previousRefreshJti` + `lastUsedAt` (momento da última rotação) dão a
// tolerância curta pra renovação concorrente com o mesmo refresh antigo, e
// `expiresAt` permite varrer sessões vencidas (ver auth-service.ts).
model Session {
  id                 String   @id
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             Int
  accessJti          String
  refreshJti         String
  previousRefreshJti String?
  createdAt          DateTime @default(now())
  lastUsedAt         DateTime @default(now())
  expiresAt          DateTime

  @@index([userId])
}

// Uma tentativa de login com Google em andamento (fluxo de redirect).
// `nonce` é o hash SHA-256 de um segredo que só existe no cookie httpOnly
// `login_nonce` do navegador que pediu o login: o hash vai pro Google e
// volta dentro do ID token, e o callback confere os dois. Uso único, 10 min
// (ver lib/login-nonce.ts).
model LoginNonce {
  nonce     String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model Receipt {
  id           Int           @id @default(autoincrement())
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId Int           @unique
  filePath     String
  mimeType     String
  status       ReceiptStatus @default(PENDING)
  adminComment String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Um registro por aparelho/navegador que ativou notificações, amarrado ao
// usuário logado que ativou — é por `userId` que notificações direcionadas
// acham os aparelhos de um aluno.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Um registro por disparo do aviso "turmas abertas" (botão do admin, push
// pra todos os aparelhos). Serve pra avisar o admin que já disparou hoje
// antes de mandar de novo — ver lib/class-opening-notifications.ts.
model ClassOpeningNotification {
  id              Int      @id @default(autoincrement())
  // Dia das turmas anunciadas (meia-noite UTC, como `ClassSession.date`).
  classDate       DateTime
  sentAt          DateTime @default(now())
  devicesNotified Int      @default(0)

  @@index([sentAt])
}
