VITE_API_URL=/api

# Client ID do OAuth do Google — o mesmo GOOGLE_CLIENT_ID do backend. Sem
# ele a tela de login mostra um erro em vez do botão do Google. Ver
# "Login com Google" em ARCHITECTURE.md (origem e URI de redirecionamento
# que precisam estar cadastradas no console do Google).
VITE_GOOGLE_CLIENT_ID=
